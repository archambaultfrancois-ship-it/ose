{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "lib": ["ES2022", "DOM", "WebWorker"],
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
