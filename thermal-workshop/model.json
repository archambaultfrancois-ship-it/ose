{
  "version": 2,
  "schemas": "schemas",
  "components": {},
  "subsystems": {
    "cell_1": {
      "source": "subsystems/cell/subsystem.json",
      "parameter_bindings": {
        "workload": "workload",
        "settings": "cells/1/settings"
      }
    },
    "cell_2": {
      "source": "subsystems/cell/subsystem.json",
      "parameter_bindings": {
        "workload": "workload",
        "settings": "cells/2/settings"
      }
    },
    "cell_3": {
      "source": "subsystems/cell/subsystem.json",
      "parameter_bindings": {
        "workload": "workload",
        "settings": "cells/3/settings"
      }
    },
    "cell_4": {
      "source": "subsystems/cell/subsystem.json",
      "parameter_bindings": {
        "workload": "workload",
        "settings": "cells/4/settings"
      }
    },
    "supervision": {
      "source": "subsystems/supervision/subsystem.json",
      "parameter_bindings": {
        "workload": "workload",
        "cell_1": "cells/1/settings",
        "cell_2": "cells/2/settings",
        "cell_3": "cells/3/settings",
        "cell_4": "cells/4/settings"
      }
    },
    "recording": {
      "source": "subsystems/recording/subsystem.json",
      "parameter_bindings": {
        "workload": "workload"
      }
    }
  },
  "subscriptions": [
    {
      "id": "analyzer_1-fusion-cell_1",
      "from": "cell_1.analysis",
      "to": "supervision.cell_1",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "supervisor-controller_1-policy",
      "from": "supervision.policy",
      "to": "cell_1.policy",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "analyzer_2-fusion-cell_2",
      "from": "cell_2.analysis",
      "to": "supervision.cell_2",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "supervisor-controller_2-policy",
      "from": "supervision.policy",
      "to": "cell_2.policy",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "analyzer_3-fusion-cell_3",
      "from": "cell_3.analysis",
      "to": "supervision.cell_3",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "supervisor-controller_3-policy",
      "from": "supervision.policy",
      "to": "cell_3.policy",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "analyzer_4-fusion-cell_4",
      "from": "cell_4.analysis",
      "to": "supervision.cell_4",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "supervisor-controller_4-policy",
      "from": "supervision.policy",
      "to": "cell_4.policy",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "fusion-historian-input",
      "from": "supervision.report",
      "to": "recording.report",
      "qos": {
        "buffer": "latest"
      }
    },
    {
      "id": "supervisor-audit-policy",
      "from": "supervision.policy",
      "to": "recording.policy",
      "qos": {
        "buffer": "fifo",
        "capacity": 16,
        "overflow": "drop_oldest",
        "ack": "received",
        "retry": {}
      }
    }
  ],
  "shared_parameters": {
    "workload": {
      "root": "Workload",
      "initial": {
        "min_samples": 64,
        "max_samples": 256,
        "burst": 1,
        "cpu_iterations": 0,
        "log_every": 20,
        "label": "nominal"
      }
    },
    "cells/1/settings": {
      "root": "CellSettings",
      "initial": {
        "target": 59.0,
        "gain": 0.012,
        "ambient": 21.0
      }
    },
    "cells/2/settings": {
      "root": "CellSettings",
      "initial": {
        "target": 63.0,
        "gain": 0.012,
        "ambient": 22.0
      }
    },
    "cells/3/settings": {
      "root": "CellSettings",
      "initial": {
        "target": 67.0,
        "gain": 0.012,
        "ambient": 23.0
      }
    },
    "cells/4/settings": {
      "root": "CellSettings",
      "initial": {
        "target": 71.0,
        "gain": 0.012,
        "ambient": 24.0
      }
    }
  }
}
