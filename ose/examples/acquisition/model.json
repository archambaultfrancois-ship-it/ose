{
  "version": 2,
  "schemas": "schemas",
  "components": {
    "acquisition": {
      "inputs": {
        "clock": {
          "kind": "timer",
          "timer": {
            "mode": "periodic",
            "delay": 0.02
          },
          "activates": {
            "timeout": [
              "measure"
            ]
          }
        }
      },
      "outputs": {
        "measure": {
          "root": "Measurement"
        }
      }
    },
    "analyse": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "activates": {
            "message": [
              "result"
            ]
          }
        }
      },
      "outputs": {
        "result": {
          "root": "Measurement"
        }
      }
    },
    "observation": {
      "inputs": {
        "input": {
          "root": "Measurement"
        }
      },
      "outputs": {}
    },
    "affichage": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "mode": "pull"
        },
        "clock": {
          "kind": "timer",
          "timer": {
            "mode": "periodic",
            "delay": 0.1
          },
          "activates": {
            "timeout": []
          }
        }
      },
      "outputs": {}
    }
  },
  "subscriptions": [
    {
      "id": "source-analyse",
      "from": "acquisition.measure",
      "to": "analyse.input",
      "qos": {
        "buffer": "fifo",
        "ack": "received",
        "retry": {}
      }
    },
    {
      "id": "analyse-observation",
      "from": "analyse.result",
      "to": "observation.input",
      "qos": {
        "buffer": "fifo",
        "ack": "received",
        "retry": {}
      }
    },
    {
      "id": "analyse-affichage",
      "from": "analyse.result",
      "to": "affichage.input",
      "qos": {
        "buffer": "latest"
      }
    }
  ]
}
