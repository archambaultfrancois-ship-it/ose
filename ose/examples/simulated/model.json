{
  "version": 2,
  "schemas": "../acquisition/schemas",
  "external_topics": {
    "external.offset": {
      "root": "Measurement"
    }
  },
  "components": {
    "source": {
      "inputs": {
        "clock": {
          "kind": "timer",
          "timer": {
            "mode": "periodic",
            "delay": 0.1
          },
          "activates": {
            "timeout": [
              "measure"
            ]
          }
        }
      },
      "outputs": {
        "measure": {
          "root": "Measurement"
        }
      }
    },
    "left": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "activates": {
            "message": [
              "result"
            ]
          }
        }
      },
      "outputs": {
        "result": {
          "root": "Measurement"
        }
      }
    },
    "right": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "activates": {
            "message": [
              "result"
            ]
          }
        }
      },
      "outputs": {
        "result": {
          "root": "Measurement"
        }
      }
    },
    "join": {
      "inputs": {
        "left": {
          "root": "Measurement",
          "activates": {
            "message": [
              "result"
            ]
          }
        },
        "right": {
          "root": "Measurement",
          "activates": {
            "message": [
              "result"
            ]
          }
        },
        "offset": {
          "root": "Measurement",
          "mode": "pull"
        }
      },
      "outputs": {
        "result": {
          "root": "Measurement"
        }
      }
    }
  },
  "subscriptions": [
    {
      "id": "source-left",
      "from": "source.measure",
      "to": "left.input"
    },
    {
      "id": "source-right",
      "from": "source.measure",
      "to": "right.input"
    },
    {
      "id": "left-join",
      "from": "left.result",
      "to": "join.left"
    },
    {
      "id": "right-join",
      "from": "right.result",
      "to": "join.right"
    },
    {
      "id": "offset-join",
      "from_topic": "external.offset",
      "to": "join.offset"
    }
  ]
}
