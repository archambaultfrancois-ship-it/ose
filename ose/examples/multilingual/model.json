{
  "version": 2,
  "schemas": "schemas",
  "components": {
    "source": {
      "inputs": {
        "clock": {
          "kind": "timer",
          "timer": {
            "mode": "periodic",
            "delay": 0.1
          },
          "activates": {
            "timeout": [
              "value"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "root": "Measurement"
        }
      }
    },
    "c_worker": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "root": "Measurement"
        }
      }
    },
    "rust_worker": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "root": "Measurement"
        }
      }
    },
    "java_worker": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "root": "Measurement"
        }
      }
    },
    "ada_worker": {
      "inputs": {
        "input": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "root": "Measurement"
        }
      }
    },
    "join": {
      "inputs": {
        "c_worker": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        },
        "rust_worker": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        },
        "java_worker": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        },
        "ada_worker": {
          "root": "Measurement",
          "activates": {
            "message": [
              "value"
            ]
          }
        }
      },
      "outputs": {
        "value": {
          "root": "Measurement"
        }
      }
    }
  },
  "subscriptions": [
    {
      "id": "source-c_worker",
      "from": "source.value",
      "to": "c_worker.input"
    },
    {
      "id": "source-rust_worker",
      "from": "source.value",
      "to": "rust_worker.input"
    },
    {
      "id": "source-java_worker",
      "from": "source.value",
      "to": "java_worker.input"
    },
    {
      "id": "source-ada_worker",
      "from": "source.value",
      "to": "ada_worker.input"
    },
    {
      "id": "c_worker-join",
      "from": "c_worker.value",
      "to": "join.c_worker"
    },
    {
      "id": "rust_worker-join",
      "from": "rust_worker.value",
      "to": "join.rust_worker"
    },
    {
      "id": "java_worker-join",
      "from": "java_worker.value",
      "to": "join.java_worker"
    },
    {
      "id": "ada_worker-join",
      "from": "ada_worker.value",
      "to": "join.ada_worker"
    }
  ]
}
